                            "value": "@pipeline().parameters.p_run_type",
                            "type": "Expression"
                        }
                    }
                },
                "linkedServiceName": {
                    "referenceName": "ls_databricks",
                    "type": "LinkedServiceReference"
                }
            }
        ],
        "parameters": {
            "p_run_date": {
                "type": "String"
            },
            "p_run_type": {
