{
    "name": "pl_silver_runner",
    "properties": {
        "description": "Generic Silver runner — called by pl_silver_dynamic_foreach once per entity.\n\nReceives three parameters from the parent ForEach:\n  p_notebook   : notebook name only (e.g. 'nb_silver_payments')\n  p_run_date   : YYYY-MM-DD or '' for full load\n  p_run_type   : 'incremental' | 'full'\n\nBuilds the full Databricks workspace path at runtime:\n  /Users/hariomsuryawanshi68258@gmail.com/<p_notebook>\n\nThis single pipeline replaces the 16 individual pl_silver_<entity> pipelines from Day 9.\nAdding a new Silver entity requires only a new row in the control table — no ADF change.",
        "activities": [
            {
                "name": "act_run_silver_notebook",
                "description": "Execute the Silver notebook whose name comes from the control table row.\nNotebook path assembled at runtime — no hard-coded entity name in this pipeline.",
                "type": "DatabricksNotebook",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.02:00:00",
                    "retry": 1,
                    "retryIntervalInSeconds": 60,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "notebookPath": {
                        "value": "@concat('/Users/hariomsuryawanshi68258@gmail.com/', pipeline().parameters.p_notebook)",
                        "type": "Expression"
                    },
                    "baseParameters": {
                        "p_run_date": {
                            "value": "@if(empty(pipeline().parameters.p_run_date), formatDateTime(pipeline().TriggerTime, 'yyyy-MM-dd'), pipeline().parameters.p_run_date)",
                            "type": "Expression"
                        },
                        "p_run_type": {
                            "value": "@pipeline().parameters.p_run_type",
                            "type": "Expression"
                        }
                    }
                },
                "linkedServiceName": {
                    "referenceName": "ls_databricks",
                    "type": "LinkedServiceReference"
                }
            }
        ],
        "parameters": {
            "p_notebook": {
                "type": "string",
                "defaultValue": "nb_silver_payments"
            },
            "p_run_date": {
                "type": "string",
                "defaultValue": ""
            },
            "p_run_type": {
                "type": "string",
                "defaultValue": "incremental"
            }
        },
        "folder": {
            "name": "silver"
        },
        "annotations": []
    },
    "type": "Microsoft.DataFactory/factories/pipelines"
}
