{
    "name": "pl_bronze_master_parallel",
    "properties": {
        "description": "Dynamic master pipeline (parallel, batchCount=5). Same notebook pattern as pl_bronze_master_foreach but ForEach runs up to 5 sources simultaneously. No Delta Lake linked service needed — uses ls_databricks (same as Day 5).",
        "activities": [
            {
                "name": "act_list_sources",
                "description": "Run nb_list_active_sources notebook — returns JSON array of active source_names",
                "type": "DatabricksNotebook",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.01:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "typeProperties": {
                    "notebookPath": "/Users/hariomsuryawanshi68258@gmail.com/nb_list_active_sources"
                },
                "linkedServiceName": {
                    "referenceName": "ls_databricks",
                    "type": "LinkedServiceReference"
                }
            },
            {
                "name": "act_set_sources",
                "description": "Store the notebook output (JSON array string) in v_sources variable",
                "type": "SetVariable",
                "dependsOn": [
                    {
                        "activity": "act_list_sources",
                        "dependencyConditions": ["Succeeded"]
                    }
                ],
                "policy": { "secureOutput": false, "secureInput": false },
                "typeProperties": {
                    "variableName": "v_sources",
                    "value": {
                        "value": "@json(activity('act_list_sources').output.runOutput)",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "act_foreach_source_parallel",
                "description": "Run up to 5 sources simultaneously. isSequential=false, batchCount=5.",
                "type": "ForEach",
                "dependsOn": [
                    {
                        "activity": "act_set_sources",
                        "dependencyConditions": ["Succeeded"]
                    }
                ],
                "typeProperties": {
                    "items": {
                        "value": "@variables('v_sources')",
                        "type": "Expression"
                    },
                    "isSequential": false,
                    "batchCount": 5,
                    "activities": [
                        {
                            "name": "act_run_source",
                            "description": "Call pl_bronze_incremental_load_v2 for the current source_name",
                            "type": "ExecutePipeline",
                            "typeProperties": {
                                "pipeline": {
                                    "referenceName": "pl_bronze_incremental_load_v2",
                                    "type": "PipelineReference"
                                },
                                "parameters": {
                                    "p_source_name": {
                                        "value": "@item()",
                                        "type": "Expression"
                                    },
                                    "p_load_type_override": {
                                        "value": "@pipeline().parameters.p_load_type_override",
                                        "type": "Expression"
                                    }
                                },
                                "waitOnCompletion": true
                            }
                        }
                    ]
                }
            }
        ],
        "parameters": {
            "p_load_type_override": {
                "type": "string",
                "defaultValue": "",
                "description": "Pass 'full' to force full reload for all sources. Leave empty to use each source's load_type from the control table."
            }
        },
        "variables": {
            "v_sources": {
                "type": "Array",
                "defaultValue": []
            }
        },
        "folder": {
            "name": "bronze"
        },
        "annotations": []
    }
}
