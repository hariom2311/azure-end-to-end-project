{
    "name": "pl_bronze_master_foreach",
    "properties": {
        "description": "Dynamic master pipeline using Lookup + ForEach (sequential). Reads all active source_names from ev_catalog.ctl.pipeline_control at runtime and calls pl_bronze_incremental_load_v2 for each one. Adding a new source = INSERT one row in the control table — no pipeline change needed.",
        "activities": [
            {
                "name": "act_lookup_sources",
                "description": "Read all active source names from the control table. Returns a list of rows — ForEach iterates over them.",
                "type": "Lookup",
                "typeProperties": {
                    "source": {
                        "type": "AzureDatabricksDeltaLakeSource",
                        "query": "SELECT source_name FROM ev_catalog.ctl.pipeline_control WHERE is_active = true ORDER BY source_name"
                    },
                    "dataset": {
                        "referenceName": "ds_pipeline_control",
                        "type": "DatasetReference"
                    },
                    "firstRowOnly": false
                }
            },
            {
                "name": "act_foreach_source",
                "description": "Iterate over each active source sequentially. isSequential=true ensures one source completes before the next starts.",
                "type": "ForEach",
                "dependsOn": [
                    {
                        "activity": "act_lookup_sources",
                        "dependencyConditions": ["Succeeded"]
                    }
                ],
                "typeProperties": {
                    "items": {
                        "value": "@activity('act_lookup_sources').output.value",
                        "type": "Expression"
                    },
                    "isSequential": true,
                    "activities": [
                        {
                            "name": "act_run_source",
                            "description": "Call the incremental load pipeline for this iteration's source_name",
                            "type": "ExecutePipeline",
                            "typeProperties": {
                                "pipeline": {
                                    "referenceName": "pl_bronze_incremental_load_v2",
                                    "type": "PipelineReference"
                                },
                                "parameters": {
                                    "p_source_name": {
                                        "value": "@item().source_name",
                                        "type": "Expression"
                                    },
                                    "p_load_type_override": {
                                        "value": "@pipeline().parameters.p_load_type_override",
                                        "type": "Expression"
                                    }
                                },
                                "waitOnCompletion": true
                            }
                        }
                    ]
                }
            }
        ],
        "parameters": {
            "p_load_type_override": {
                "type": "string",
                "defaultValue": "",
                "description": "Pass 'full' to force full reload for all sources. Leave empty to use each source's load_type from the control table."
            }
        },
        "folder": {
            "name": "bronze"
        },
        "annotations": []
    }
}
