{
    "name": "pl_bronze_master_foreach",
    "properties": {
        "description": "Dynamic master pipeline (sequential). nb_list_active_sources notebook reads all active source_names from the control table and returns a JSON array string. ForEach iterates over it directly using @json(string(activity output)). No SetVariable needed — avoids ADF String/Array type conflict.",
        "activities": [
            {
                "name": "act_list_sources",
                "description": "Run nb_list_active_sources notebook — exits with json.dumps([source_names]) string",
                "type": "DatabricksNotebook",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.01:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "typeProperties": {
                    "notebookPath": "/Users/hariomsuryawanshi68258@gmail.com/nb_list_active_sources"
                },
                "linkedServiceName": {
                    "referenceName": "ls_databricks",
                    "type": "LinkedServiceReference"
                }
            },
            {
                "name": "act_foreach_source",
                "description": "Iterate sequentially over each active source_name. string() forces runOutput to a string before json() parses it — avoids the Array type conflict on SetVariable.",
                "type": "ForEach",
                "dependsOn": [
                    {
                        "activity": "act_list_sources",
                        "dependencyConditions": ["Succeeded"]
                    }
                ],
                "typeProperties": {
                    "items": {
                        "value": "@json(string(activity('act_list_sources').output.runOutput))",
                        "type": "Expression"
                    },
                    "isSequential": true,
                    "activities": [
                        {
                            "name": "act_run_source",
                            "description": "Call pl_bronze_incremental_load_v2 for the current source_name",
                            "type": "ExecutePipeline",
                            "typeProperties": {
                                "pipeline": {
                                    "referenceName": "pl_bronze_incremental_load_v2",
                                    "type": "PipelineReference"
                                },
                                "parameters": {
                                    "p_source_name": {
                                        "value": "@item()",
                                        "type": "Expression"
                                    },
                                    "p_load_type_override": {
                                        "value": "@pipeline().parameters.p_load_type_override",
                                        "type": "Expression"
                                    }
                                },
                                "waitOnCompletion": true
                            }
                        }
                    ]
                }
            }
        ],
        "parameters": {
            "p_load_type_override": {
                "type": "string",
                "defaultValue": "",
                "description": "Pass 'full' to force full reload for all sources. Leave empty to use each source's load_type from the control table."
            }
        },
        "variables": {},
        "folder": {
            "name": "bronze"
        },
        "annotations": []
    }
}
