{
  "name": "pl_bronze_blob_ingestion",
  "properties": {
    "description": "Loads three blob source types from dataenggdailystorage/source into the bronze ADLS Gen2 container.\n  - config/    → all XML files (full load)\n  - invoices/  → all PDF files recursively (full load)\n  - reports/   → all JSON files recursively (full load)\nAll three copy activities run in parallel. Sink paths follow the medallion pattern with ingestion_date and run_id partitions.",
    "activities": [
      {
        "name": "act_copy_config",
        "description": "Full copy of all XML files from source/config/",
        "type": "Copy",
        "dependsOn": [],
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "BinarySource",
            "storeSettings": {
              "type": "AzureBlobStorageReadSettings",
              "recursive": true,
              "enablePartitionDiscovery": false
            }
          },
          "sink": {
            "type": "BinarySink",
            "storeSettings": {
              "type": "AzureBlobFSWriteSettings"
            }
          },
          "enableStaging": false
        },
        "inputs": [
          {
            "referenceName": "ds_blob_config_src",
            "type": "DatasetReference"
          }
        ],
        "outputs": [
          {
            "referenceName": "ds_bronze_blob_sink",
            "type": "DatasetReference",
            "parameters": {
              "p_folder": {
                "value": "@concat('blob/config/ingestion_date=', formatDateTime(utcnow(), 'yyyy-MM-dd'), '/run_id=', pipeline().RunId)",
                "type": "Expression"
              }
            }
          }
        ]
      },
      {
        "name": "act_copy_invoices",
        "description": "Full copy of all PDF files from source/invoices/ recursively (all years/months/days)",
        "type": "Copy",
        "dependsOn": [],
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "BinarySource",
            "storeSettings": {
              "type": "AzureBlobStorageReadSettings",
              "recursive": true,
              "enablePartitionDiscovery": false
            }
          },
          "sink": {
            "type": "BinarySink",
            "storeSettings": {
              "type": "AzureBlobFSWriteSettings"
            }
          },
          "enableStaging": false
        },
        "inputs": [
          {
            "referenceName": "ds_blob_invoices_src",
            "type": "DatasetReference"
          }
        ],
        "outputs": [
          {
            "referenceName": "ds_bronze_blob_sink",
            "type": "DatasetReference",
            "parameters": {
              "p_folder": {
                "value": "@concat('blob/invoices/ingestion_date=', formatDateTime(utcnow(), 'yyyy-MM-dd'), '/run_id=', pipeline().RunId)",
                "type": "Expression"
              }
            }
          }
        ]
      },
      {
        "name": "act_copy_reports",
        "description": "Full copy of all JSON files from source/reports/ recursively (all years/months)",
        "type": "Copy",
        "dependsOn": [],
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "BinarySource",
            "storeSettings": {
              "type": "AzureBlobStorageReadSettings",
              "recursive": true,
              "enablePartitionDiscovery": false
            }
          },
          "sink": {
            "type": "BinarySink",
            "storeSettings": {
              "type": "AzureBlobFSWriteSettings"
            }
          },
          "enableStaging": false
        },
        "inputs": [
          {
            "referenceName": "ds_blob_reports_src",
            "type": "DatasetReference"
          }
        ],
        "outputs": [
          {
            "referenceName": "ds_bronze_blob_sink",
            "type": "DatasetReference",
            "parameters": {
              "p_folder": {
                "value": "@concat('blob/reports/ingestion_date=', formatDateTime(utcnow(), 'yyyy-MM-dd'), '/run_id=', pipeline().RunId)",
                "type": "Expression"
              }
            }
          }
        ]
      }
    ],
    "annotations": [],
    "lastPublishTime": "2026-10-19T00:00:00Z"
  },
  "type": "Microsoft.DataFactory/factories/pipelines"
}
