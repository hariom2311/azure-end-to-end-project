{
  "name": "pl_bronze_blob_ingestion",
  "properties": {
    "description": "Loads three blob source types from dataenggdailystorage/source into the bronze ADLS Gen2 container.\n  - config/      → full load always (all XML files)\n  - invoices/    → full load for previous day's date folder (YYYY/MM/DD)\n  - reports/     → full load always for current month (YYYY/MM)\nAll three copy activities run in parallel. Sink paths follow the medallion pattern with ingestion_date and run_id partitions.\n\np_invoice_date: override for invoices folder (YYYY/MM/DD). Leave empty to use yesterday.\np_report_month: override for reports folder (YYYY/MM). Leave empty to use current month.",
    "parameters": {
      "p_invoice_date": {
        "type": "String",
        "defaultValue": ""
      },
      "p_report_month": {
        "type": "String",
        "defaultValue": ""
      }
    },
    "activities": [
      {
        "name": "act_copy_config",
        "description": "Full copy of all XML files from source/config/ into bronze/blob/config/ingestion_date=<today>/run_id=<RunId>/",
        "type": "Copy",
        "dependsOn": [],
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "BinarySource",
            "storeSettings": {
              "type": "AzureBlobStorageReadSettings",
              "recursive": false,
              "wildcardFileName": "*.xml",
              "enablePartitionDiscovery": false
            }
          },
          "sink": {
            "type": "BinarySink",
            "storeSettings": {
              "type": "AzureBlobFSWriteSettings"
            }
          },
          "enableStaging": false,
          "preserve": [],
          "preserveRules": []
        },
        "inputs": [
          {
            "referenceName": "ds_blob_config_src",
            "type": "DatasetReference"
          }
        ],
        "outputs": [
          {
            "referenceName": "ds_bronze_blob_sink",
            "type": "DatasetReference",
            "parameters": {
              "p_folder": {
                "value": "@concat('blob/config/ingestion_date=', formatDateTime(utcnow(), 'yyyy-MM-dd'), '/run_id=', pipeline().RunId)",
                "type": "Expression"
              }
            }
          }
        ]
      },
      {
        "name": "act_copy_invoices",
        "description": "Full copy of all PDF invoices from source/invoices/<yesterday YYYY/MM/DD>/ into bronze/blob/invoices/ingestion_date=<yesterday>/run_id=<RunId>/. Yesterday's folder because invoices are finalized for the previous day.",
        "type": "Copy",
        "dependsOn": [],
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "BinarySource",
            "storeSettings": {
              "type": "AzureBlobStorageReadSettings",
              "recursive": false,
              "wildcardFolderPath": {
                "value": "@concat('invoices/', if(empty(pipeline().parameters.p_invoice_date), formatDateTime(addDays(utcnow(), -1), 'yyyy/MM/dd'), pipeline().parameters.p_invoice_date))",
                "type": "Expression"
              },
              "wildcardFileName": "*.pdf",
              "enablePartitionDiscovery": false
            }
          },
          "sink": {
            "type": "BinarySink",
            "storeSettings": {
              "type": "AzureBlobFSWriteSettings"
            }
          },
          "enableStaging": false
        },
        "inputs": [
          {
            "referenceName": "ds_blob_invoices_src",
            "type": "DatasetReference"
          }
        ],
        "outputs": [
          {
            "referenceName": "ds_bronze_blob_sink",
            "type": "DatasetReference",
            "parameters": {
              "p_folder": {
                "value": "@concat('blob/invoices/ingestion_date=', if(empty(pipeline().parameters.p_invoice_date), formatDateTime(addDays(utcnow(), -1), 'yyyy-MM-dd'), replace(pipeline().parameters.p_invoice_date, '/', '-')), '/run_id=', pipeline().RunId)",
                "type": "Expression"
              }
            }
          }
        ]
      },
      {
        "name": "act_copy_reports",
        "description": "Full copy of all JSON report files from source/reports/<current YYYY/MM>/ into bronze/blob/reports/ingestion_date=<today>/run_id=<RunId>/. Month-level folder because reports are monthly aggregates.",
        "type": "Copy",
        "dependsOn": [],
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "BinarySource",
            "storeSettings": {
              "type": "AzureBlobStorageReadSettings",
              "recursive": false,
              "wildcardFolderPath": {
                "value": "@concat('reports/', if(empty(pipeline().parameters.p_report_month), formatDateTime(utcnow(), 'yyyy/MM'), pipeline().parameters.p_report_month))",
                "type": "Expression"
              },
              "wildcardFileName": "*.json",
              "enablePartitionDiscovery": false
            }
          },
          "sink": {
            "type": "BinarySink",
            "storeSettings": {
              "type": "AzureBlobFSWriteSettings"
            }
          },
          "enableStaging": false
        },
        "inputs": [
          {
            "referenceName": "ds_blob_reports_src",
            "type": "DatasetReference"
          }
        ],
        "outputs": [
          {
            "referenceName": "ds_bronze_blob_sink",
            "type": "DatasetReference",
            "parameters": {
              "p_folder": {
                "value": "@concat('blob/reports/ingestion_date=', if(empty(pipeline().parameters.p_report_month), formatDateTime(utcnow(), 'yyyy-MM-dd'), concat(replace(pipeline().parameters.p_report_month, '/', '-'), '-01')), '/run_id=', pipeline().RunId)",
                "type": "Expression"
              }
            }
          }
        ]
      }
    ],
    "annotations": [],
    "lastPublishTime": "2026-10-19T00:00:00Z"
  },
  "type": "Microsoft.DataFactory/factories/pipelines"
}
