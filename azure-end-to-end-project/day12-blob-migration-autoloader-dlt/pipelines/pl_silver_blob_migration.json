{
    "name": "pl_silver_blob_migration",
    "properties": {
        "description": "Migrates blob source files from dataenggdailystorage/source into Silver ADLS Gen2 (silver container).\n\nThree categories mirrored from the Bronze blob pipeline:\n  config/  — always full load, small reference XML, fixed sink path\n  invoices/ — full = all PDFs recursively | incremental = previous day only\n  reports/  — full = all JSONs recursively | incremental = previous month only\n\np_load_type = full        : all files, sink = silver-blob/<type>/load_type=full/\np_load_type = incremental : sink = silver-blob/<type>/ingestion_date=<date>/\nRe-run on same date overwrites same folder (idempotent).",
        "activities": [
            {
                "name": "act_copy_config_silver",
                "description": "Config XML — always full load into Silver blob directory.",
                "type": "Copy",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.02:00:00",
                    "retry": 2,
                    "retryIntervalInSeconds": 60,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "BinarySource",
                        "storeSettings": {
                            "type": "AzureBlobStorageReadSettings",
                            "recursive": true
                        },
                        "formatSettings": {
                            "type": "BinaryReadSettings"
                        }
                    },
                    "sink": {
                        "type": "BinarySink",
                        "storeSettings": {
                            "type": "AzureBlobFSWriteSettings"
                        }
                    },
                    "enableStaging": false
                },
                "inputs": [
                    {
                        "referenceName": "ds_blob_config_src",
                        "type": "DatasetReference"
                    }
                ],
                "outputs": [
                    {
                        "referenceName": "ds_silver_blob_sink",
                        "type": "DatasetReference",
                        "parameters": {
                            "p_folder": "silver-blob/config/load_type=full"
                        }
                    }
                ]
            },
            {
                "name": "act_load_invoices_silver",
                "description": "Routes invoice copy to Silver: full = all PDFs, incremental = previous day only.",
                "type": "IfCondition",
                "dependsOn": [],
                "userProperties": [],
                "typeProperties": {
                    "expression": {
                        "value": "@equals(toLower(pipeline().parameters.p_load_type), 'full')",
                        "type": "Expression"
                    },
                    "ifTrueActivities": [
                        {
                            "name": "act_copy_invoices_full_silver",
                            "description": "Full load — all PDFs from all date folders recursively into Silver.",
                            "type": "Copy",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.04:00:00",
                                "retry": 2,
                                "retryIntervalInSeconds": 60,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "BinarySource",
                                    "storeSettings": {
                                        "type": "AzureBlobStorageReadSettings",
                                        "recursive": true
                                    },
                                    "formatSettings": {
                                        "type": "BinaryReadSettings"
                                    }
                                },
                                "sink": {
                                    "type": "BinarySink",
                                    "storeSettings": {
                                        "type": "AzureBlobFSWriteSettings"
                                    }
                                },
                                "enableStaging": false
                            },
                            "inputs": [
                                {
                                    "referenceName": "ds_blob_invoices_src",
                                    "type": "DatasetReference"
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "ds_silver_blob_sink",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "p_folder": "silver-blob/invoices/load_type=full"
                                    }
                                }
                            ]
                        }
                    ],
                    "ifFalseActivities": [
                        {
                            "name": "act_copy_invoices_incremental_silver",
                            "description": "Incremental — previous day PDFs only. Sink partitioned by ingestion_date, idempotent on re-run.",
                            "type": "Copy",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.02:00:00",
                                "retry": 2,
                                "retryIntervalInSeconds": 60,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "BinarySource",
                                    "storeSettings": {
                                        "type": "AzureBlobStorageReadSettings",
                                        "recursive": false,
                                        "wildcardFolderPath": {
                                            "value": "@concat('invoices/', formatDateTime(addDays(utcnow(), -1), 'yyyy/MM/dd'))",
                                            "type": "Expression"
                                        }
                                    },
                                    "formatSettings": {
                                        "type": "BinaryReadSettings"
                                    }
                                },
                                "sink": {
                                    "type": "BinarySink",
                                    "storeSettings": {
                                        "type": "AzureBlobFSWriteSettings"
                                    }
                                },
                                "enableStaging": false
                            },
                            "inputs": [
                                {
                                    "referenceName": "ds_blob_invoices_src",
                                    "type": "DatasetReference"
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "ds_silver_blob_sink",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "p_folder": {
                                            "value": "@concat('silver-blob/invoices/ingestion_date=', formatDateTime(addDays(utcnow(), -1), 'yyyy-MM-dd'))",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ]
                        }
                    ]
                }
            },
            {
                "name": "act_load_reports_silver",
                "description": "Routes report copy to Silver: full = all JSONs, incremental = previous month only.",
                "type": "IfCondition",
                "dependsOn": [],
                "userProperties": [],
                "typeProperties": {
                    "expression": {
                        "value": "@equals(toLower(pipeline().parameters.p_load_type), 'full')",
                        "type": "Expression"
                    },
                    "ifTrueActivities": [
                        {
                            "name": "act_copy_reports_full_silver",
                            "description": "Full load — all JSONs from all month folders recursively into Silver.",
                            "type": "Copy",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.02:00:00",
                                "retry": 2,
                                "retryIntervalInSeconds": 60,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "BinarySource",
                                    "storeSettings": {
                                        "type": "AzureBlobStorageReadSettings",
                                        "recursive": true
                                    },
                                    "formatSettings": {
                                        "type": "BinaryReadSettings"
                                    }
                                },
                                "sink": {
                                    "type": "BinarySink",
                                    "storeSettings": {
                                        "type": "AzureBlobFSWriteSettings"
                                    }
                                },
                                "enableStaging": false
                            },
                            "inputs": [
                                {
                                    "referenceName": "ds_blob_reports_src",
                                    "type": "DatasetReference"
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "ds_silver_blob_sink",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "p_folder": "silver-blob/reports/load_type=full"
                                    }
                                }
                            ]
                        }
                    ],
                    "ifFalseActivities": [
                        {
                            "name": "act_copy_reports_incremental_silver",
                            "description": "Incremental — previous month JSONs only. Sink partitioned by ingestion_date, idempotent on re-run.",
                            "type": "Copy",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.02:00:00",
                                "retry": 2,
                                "retryIntervalInSeconds": 60,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "BinarySource",
                                    "storeSettings": {
                                        "type": "AzureBlobStorageReadSettings",
                                        "recursive": false,
                                        "wildcardFolderPath": {
                                            "value": "@concat('reports/', formatDateTime(addDays(startOfMonth(utcnow()), -1), 'yyyy/MM'))",
                                            "type": "Expression"
                                        }
                                    },
                                    "formatSettings": {
                                        "type": "BinaryReadSettings"
                                    }
                                },
                                "sink": {
                                    "type": "BinarySink",
                                    "storeSettings": {
                                        "type": "AzureBlobFSWriteSettings"
                                    }
                                },
                                "enableStaging": false
                            },
                            "inputs": [
                                {
                                    "referenceName": "ds_blob_reports_src",
                                    "type": "DatasetReference"
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "ds_silver_blob_sink",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "p_folder": {
                                            "value": "@concat('silver-blob/reports/ingestion_date=', formatDateTime(addDays(startOfMonth(utcnow()), -1), 'yyyy-MM'))",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ]
                        }
                    ]
                }
            }
        ],
        "parameters": {
            "p_load_type": {
                "type": "String",
                "defaultValue": "incremental"
            }
        },
        "annotations": [],
        "lastPublishTime": "2026-10-30T00:00:00Z"
    },
    "type": "Microsoft.DataFactory/factories/pipelines"
}
