{
    "name": "pl_master_e2e",
    "properties": {
        "description": "End-to-end master pipeline (Day 11).\n\nFlow:\n  1. act_list_sources      — nb_list_active_sources reads Bronze control table\n  2. act_foreach_source    — ForEach calls pl_bronze_incremental_load_v3 per source\n  3. act_silver_dynamic    — ExecutePipeline -> pl_silver_dynamic_foreach\n  4. act_gold_dynamic      — ExecutePipeline -> pl_gold_dynamic_foreach\n\nAdding a Bronze source  : INSERT into ev_catalog.ctl.pipeline_control\nAdding a Silver entity  : INSERT into ev_catalog.silver.silver_control\nAdding a Gold notebook  : INSERT into ev_catalog.gold.gold_control\nNo ADF changes needed for any of the above.",
        "activities": [
            {
                "name": "act_list_sources",
                "description": "Run nb_list_active_sources — exits with json.dumps([source_names]) string",
                "type": "DatabricksNotebook",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.01:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "notebookPath": "/Users/hariomsuryawanshi68258@gmail.com/nb_list_active_sources"
                },
                "linkedServiceName": {
                    "referenceName": "ls_databricks",
                    "type": "LinkedServiceReference"
                }
            },
            {
                "name": "act_foreach_source",
                "description": "Iterate sequentially over each active Bronze source.",
                "type": "ForEach",
                "dependsOn": [
                    {
                        "activity": "act_list_sources",
                        "dependencyConditions": ["Succeeded"]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@json(string(activity('act_list_sources').output.runOutput))",
                        "type": "Expression"
                    },
                    "isSequential": true,
                    "activities": [
                        {
                            "name": "act_run_source",
                            "type": "ExecutePipeline",
                            "dependsOn": [],
                            "policy": { "secureInput": false },
                            "userProperties": [],
                            "typeProperties": {
                                "pipeline": {
                                    "referenceName": "pl_bronze_incremental_load_v3",
                                    "type": "PipelineReference"
                                },
                                "waitOnCompletion": true,
                                "parameters": {
                                    "p_source_name": {
                                        "value": "@item()",
                                        "type": "Expression"
                                    },
                                    "p_load_type_override": {
                                        "value": "@pipeline().parameters.p_load_type_override",
                                        "type": "Expression"
                                    }
                                }
                            }
                        }
                    ]
                }
            },
            {
                "name": "act_silver_dynamic",
                "description": "After Bronze completes, run all active Silver notebooks via control table.",
                "type": "ExecutePipeline",
                "dependsOn": [
                    {
                        "activity": "act_foreach_source",
                        "dependencyConditions": ["Succeeded"]
                    }
                ],
                "policy": { "secureInput": false },
                "userProperties": [],
                "typeProperties": {
                    "pipeline": {
                        "referenceName": "pl_silver_dynamic_foreach",
                        "type": "PipelineReference"
                    },
                    "waitOnCompletion": true,
                    "parameters": {
                        "p_run_date": {
                            "value": "@pipeline().parameters.p_run_date",
                            "type": "Expression"
                        },
                        "p_run_type": {
                            "value": "@pipeline().parameters.p_run_type",
                            "type": "Expression"
                        }
                    }
                }
            },
            {
                "name": "act_gold_dynamic",
                "description": "After Silver completes, run all active Gold notebooks via control table.\nDims → Facts → Marts order is guaranteed by run_order in gold_control.",
                "type": "ExecutePipeline",
                "dependsOn": [
                    {
                        "activity": "act_silver_dynamic",
                        "dependencyConditions": ["Succeeded"]
                    }
                ],
                "policy": { "secureInput": false },
                "userProperties": [],
                "typeProperties": {
                    "pipeline": {
                        "referenceName": "pl_gold_dynamic_foreach",
                        "type": "PipelineReference"
                    },
                    "waitOnCompletion": true,
                    "parameters": {
                        "p_run_date": {
                            "value": "@pipeline().parameters.p_run_date",
                            "type": "Expression"
                        },
                        "p_run_type": {
                            "value": "@pipeline().parameters.p_run_type",
                            "type": "Expression"
                        }
                    }
                }
            }
        ],
        "parameters": {
            "p_load_type_override": {
                "type": "string",
                "defaultValue": ""
            },
            "p_run_date": {
                "type": "string",
                "defaultValue": ""
            },
            "p_run_type": {
                "type": "string",
                "defaultValue": "incremental"
            }
        },
        "folder": {
            "name": "master"
        },
        "annotations": []
    },
    "type": "Microsoft.DataFactory/factories/pipelines"
}
