{
    "name": "pl_gold_dynamic_foreach",
    "properties": {
        "description": "Dynamic Gold master pipeline.\n\nFlow:\n  1. act_list_gold_notebooks  — Databricks notebook reads ev_catalog.gold.gold_control\n                                 WHERE is_active = true ORDER BY run_order\n                                 exits with: json.dumps([{notebook_name, layer}, ...])\n  2. act_foreach_gold         — ForEach (sequential) over the JSON array\n     └── act_run_gold_runner  — ExecutePipeline -> pl_gold_runner\n                                 passes p_notebook, p_run_date, p_run_type\n\nDims run before Facts before Marts because run_order controls sequence.\nAdding a new Gold notebook = INSERT one row into ev_catalog.gold.gold_control.",
        "activities": [
            {
                "name": "act_list_gold_notebooks",
                "description": "Read ev_catalog.gold.gold_control WHERE is_active=true ORDER BY run_order.\nReturns JSON array string: [{\"notebook_name\":\"nb_gold_dim_station\",\"layer\":\"dim\"}, ...]",
                "type": "DatabricksNotebook",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.00:10:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "notebookPath": "/Users/hariomsuryawanshi68258@gmail.com/nb_list_gold_notebooks",
                    "baseParameters": {}
                },
                "linkedServiceName": {
                    "referenceName": "ls_databricks",
                    "type": "LinkedServiceReference"
                }
            },
            {
                "name": "act_foreach_gold",
                "description": "Iterate sequentially over each active Gold notebook entry.\nDims (run_order 1-9) always finish before Facts (10-19) before Marts (20+).",
                "type": "ForEach",
                "dependsOn": [
                    {
                        "activity": "act_list_gold_notebooks",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@json(string(activity('act_list_gold_notebooks').output.runOutput))",
                        "type": "Expression"
                    },
                    "isSequential": true,
                    "activities": [
                        {
                            "name": "act_run_gold_runner",
                            "description": "Call pl_gold_runner for the current Gold notebook.",
                            "type": "ExecutePipeline",
                            "dependsOn": [],
                            "policy": {
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "pipeline": {
                                    "referenceName": "pl_gold_runner",
                                    "type": "PipelineReference"
                                },
                                "waitOnCompletion": true,
                                "parameters": {
                                    "p_notebook": {
                                        "value": "@item().notebook_name",
                                        "type": "Expression"
                                    },
                                    "p_run_date": {
                                        "value": "@pipeline().parameters.p_run_date",
                                        "type": "Expression"
                                    },
                                    "p_run_type": {
                                        "value": "@pipeline().parameters.p_run_type",
                                        "type": "Expression"
                                    }
                                }
                            }
                        }
                    ]
                }
            }
        ],
        "parameters": {
            "p_run_date": {
                "type": "string",
                "defaultValue": ""
            },
            "p_run_type": {
                "type": "string",
                "defaultValue": "incremental"
            }
        },
        "folder": {
            "name": "gold"
        },
        "annotations": []
    },
    "type": "Microsoft.DataFactory/factories/pipelines"
}
